# ---------------------------------------------------------------------------
# Copia este archivo como `.env` y rellena los valores reales.
# El archivo `.env` NO se sube a git (ya esta en .gitignore).
# ---------------------------------------------------------------------------

# --- Base de datos (Neon / PostgreSQL) -------------------------------------
# DATABASE_URL: cadena "pooled" de Neon. Es la que usa la aplicacion.
#   Se reconoce porque el host lleva "-pooler".
DATABASE_URL="postgresql://USUARIO:CONTRASENA@ep-xxxx-pooler.REGION.aws.neon.tech/neondb?sslmode=require"
# DIRECT_URL: cadena directa (sin "-pooler"). Solo la usan las migraciones.
DIRECT_URL="postgresql://USUARIO:CONTRASENA@ep-xxxx.REGION.aws.neon.tech/neondb?sslmode=require"

# --- Autenticacion (Auth.js / NextAuth v5) ---------------------------------
# Secreto para firmar las cookies de sesion. Genera uno con:
#   npx auth secret
# o bien:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
AUTH_SECRET="pega-aqui-un-secreto-largo-y-aleatorio"

# Credenciales del unico administrador. Se usan al ejecutar `npm run db:seed`,
# que guarda el usuario en la base de datos con la contrasena ya hasheada.
# El .env local trae "dibujo2026" como clave de arranque: CAMBIALA aqui y vuelve
# a ejecutar `npm run db:seed` para que quede actualizada.
ADMIN_USERNAME="admin"
ADMIN_PASSWORD="cambiar-esta-clave"

# --- Almacenamiento de archivos (Vercel Blob) ------------------------------
# Se obtiene en el panel de Vercel: Storage > Blob > conectar al proyecto.
# En local se descarga con `vercel env pull`.
BLOB_READ_WRITE_TOKEN="vercel_blob_rw_XXXXXXXX_XXXXXXXXXXXXXXXX"
